{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "backend/**",
        "src/**"
      ]
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}